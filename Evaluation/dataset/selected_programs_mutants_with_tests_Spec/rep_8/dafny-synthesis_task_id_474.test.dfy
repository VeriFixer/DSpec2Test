
method {:test} Test7() {
var r0 := ReplaceChars("\U{0001}a\U{0001}", '\U{0001}', '\0');
expect |r0| == |"\U{0001}a\U{0001}"|;
expect forall i :: 0 <= i < |"\U{0001}a\U{0001}"| ==> ("\U{0001}a\U{0001}"[i] == '\U{0001}' ==> r0[i] == '\0') && ("\U{0001}a\U{0001}"[i] != '\U{0001}' ==> r0[i] == "\U{0001}a\U{0001}"[i]);
}

