
method {:test} Test3() {
var r0 := ReplaceChars("\U{0002}\0", '\U{0001}', '\0');
expect |r0| == |"\U{0002}\0"|;
expect forall i :: 0 <= i < |"\U{0002}\0"| ==> ("\U{0002}\0"[i] == '\U{0001}' ==> r0[i] == '\0') && ("\U{0002}\0"[i] != '\U{0001}' ==> r0[i] == "\U{0002}\0"[i]);
}

