var r0 := has_close_elements(seqreal0, 2441.0);
expect r0 <==> exists i, j :: 0 <= i < |seqreal0| && 0 <= j < |seqreal0| && i != j && abs(seqreal0[i] - seqreal0[j]) < 2441.0;
expect r0 ==> |seqreal0| > 1;
}
